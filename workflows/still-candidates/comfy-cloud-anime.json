            0
          ],
          "negative": [
            "negative",
            0
          ],
          "latent_image": [
            "latent",
            0
          ]
        }
      },
      "decode": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": [
            "sampler",
            0
          ],
          "vae": [
            "vae",
            0
          ]
        }
      },
      "save": {
        "class_type": "SaveImage",
        "inputs": {
          "images": [
            "decode",
            0
